generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id                  String   @id @default(cuid())
  name                String
  aliases             String[]
  state               String
  city                String
  lat                 Float?
  lng                 Float?
  type                String   // govt / private / deemed / central
  quota_types         String[] // AIQ, state, deemed, central
  total_seats         Int?
  nirf_rank           Int?
  nirf_score          Float?
  beds                Int?
  patient_count_opd   Int?
  hostel_infra_score  Float?   // derived signal, see Architecture.md §6
  faculty_signal      Float?   // derived signal, see Architecture.md §6
  google_place_id     String?
  google_rating       Float?
  google_review_count Int?
  source_updated_at   DateTime @default(now())

  @@map("colleges")
}
